# Local dev — auth disabled by default (npm run dev)
FINANCE_AUTH=off
API_PORT=5174

# Optional: simulate production auth locally
# FINANCE_AUTH=on
# FINANCE_USERNAME=nicholas
# FINANCE_PASSWORD=change-me-min-8
# FINANCE_SECRET=generate-with-openssl-rand-hex-32
# FINANCE_ALLOW_REGISTER=on   # default: closed after first user exists

# Railway production (set in dashboard, never commit real values)
# NODE_ENV=production
# FINANCE_AUTH=on
# FINANCE_USERNAME=
# FINANCE_PASSWORD=
# FINANCE_SECRET=
# FINANCE_ALLOW_REGISTER=off
# DATABASE_PATH=/data/finance.db
# PAYSLIPS_DIR=/data/payslips
# PORT=          # injected by Railway

# Open Banking (GoCardless) — optional
# GOCARDLESS_SECRET_ID=
# GOCARDLESS_SECRET_KEY=
# GOCARDLESS_INSTITUTION_MEDIOLANUM=
# GOCARDLESS_INSTITUTION_REVOLUT=
# BANK_SYNC_REDIRECT_URL=https://your-app.example/api/bank-sync/callback
# BANK_SYNC_CRON=off   # disable daily 06:00 Europe/Rome sync
